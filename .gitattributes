# Normalize all text files to LF in the repository; Git converts on checkout
# per the platform. Prevents the mixed CRLF/CR churn that inflated diffs.
* text=auto eol=lf

# Windows-specific scripts must stay CRLF to run correctly.
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf
*.nsh   text eol=crlf
*.nsi   text eol=crlf

# Binary assets — never touch line endings or attempt text diffs.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.icns  binary
*.wav   binary
*.mp3   binary
*.ogg   binary
*.zip   binary
*.exe   binary
*.dll   binary
*.node  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
