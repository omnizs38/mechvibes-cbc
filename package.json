{
  "name": "mechvibes",
  "productName": "Mechvibes",
  "version": "2.5.3",
  "description": "Low-latency mechanical keyboard sound engine for Windows.",
  "repository": "https://github.com/omnizs38/mechvibes-cbc",
  "main": "src/main.js",
  "scripts": {
    "start": "npm run build:main && npm run build:renderer && electron .",
    "build:main": "tsc -p tsconfig.json",
    "dev:renderer": "vite",
    "build:renderer": "vite build",
    "build:web": "tsc -p public/tsconfig.json",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.renderer.json && tsc --noEmit -p public/tsconfig.json",
    "lint": "npm run typecheck",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,html}\" \"tools/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,html}\" \"tools/**/*.ts\" \"tests/**/*.ts\"",
    "diagnose": "tsc tools/diagnose.ts --outDir dist --module commonjs && node dist/tools/diagnose.js",
    "build:soundpack": "tsc tools/soundpack-builder-cli.ts tools/soundpack-scanner.ts tools/soundpack-config-generator.ts --outDir dist --module commonjs && node dist/tools/soundpack-builder-cli.js",
    "build:all": "npm run build:main && npm run build:renderer && electron-builder -wml",
    "build:win": "npm run build:main && npm run build:renderer && electron-builder -w",
    "build:mac": "npm run build:main && npm run build:renderer && electron-builder -m",
    "build:linux": "npm run build:main && npm run build:renderer && electron-builder -l",
    "build:win:dir": "npm run build:main && npm run build:renderer && electron-builder --win --x64 --dir --publish never",
    "build:clean": "npm run build:main && node tools/clean-dist.js",
    "check": "npm run build:main && node tools/check-syntax.js",
    "test": "npm run build:main && node tests/run.js",
    "benchmark:audio": "npm run build:main && node tools/audio-benchmark.js",
    "verify": "npm run check && npm test && npm run typecheck"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [],
  "homepage": "https://mechvibes-cbc.pages.dev/",
  "author": {
    "name": "Hai Nguyen",
    "email": "hainguyen.ts13@gmail.com"
  },
  "license": "MPL-2.0",
  "build": {
    "appId": "com.electron.mechvibes-cbc",
    "artifactName": "Mechvibes-${version}-${arch}.${ext}",
    "files": [
      "src/**/*",
      "package.json",
      "!src/**/*.map",
      "!src/**/*.ts",
      "!src/**/*.tsx",
      "!src/renderer/**/*"
    ],
    "generateUpdatesFilesForAllChannels": true,
    "publish": [
      {
        "provider": "github",
        "owner": "omnizs38",
        "repo": "mechvibes-cbc"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "./build/installer.nsh"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/assets/icon.png"
    },
    "mac": {
      "category": "public.app-category.entertainment",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/assets/icon.png"
    },
    "linux": {
      "category": "Utility",
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "snap",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/assets/icon.png"
    }
  },
  "dependencies": {
    "@electron/remote": "^2.1.3",
    "adm-zip": "^0.6.0",
    "easy-volume": "^1.2.0",
    "electron-log": "^5.4.4",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "fs-extra": "^11.4.0",
    "mime-types": "^3.0.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/fs-extra": "^11.0.4",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.7",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  }
}
