{
  "name": "mechvibes",
  "productName": "Mechvibes",
  "version": "3.0.0-beta.1",
  "description": "Low-latency mechanical keyboard sounds for Windows, macOS and Linux.",
  "repository": "https://github.com/omnizs38/mechvibes-cbc",
  "main": "src/main.js",
  "scripts": {
    "start": "npm run build:main && npm run build:renderer && electron .",
    "build:main": "tsc -p tsconfig.json",
    "dev:renderer": "vite",
    "build:renderer": "vite build",
    "build:web": "tsc -p public/tsconfig.json",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.renderer.json && tsc --noEmit -p public/tsconfig.json",
    "lint": "npm run typecheck",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,html}\" \"tools/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,html}\" \"tools/**/*.ts\" \"tests/**/*.ts\"",
    "diagnose": "npm run build:main && node tools/diagnose.js",
    "build:soundpack": "npm run build:main && node tools/soundpack-builder-cli.js",
    "build:all": "npm run build:app && electron-builder -wml --publish never",
    "build:win": "npm run build:app && electron-builder -w --publish never",
    "build:mac": "npm run build:app && electron-builder -m --publish never",
    "build:linux": "npm run build:app && electron-builder -l --publish never",
    "build:win:dir": "npm run build:app && electron-builder --win --x64 --dir --publish never",
    "build:clean": "npm run build:main && node tools/clean-dist.js",
    "check": "npm run build:main && node tools/check-syntax.js",
    "test": "npm run build:main && npm run test:unit",
    "benchmark:audio": "npm run build:main && node tools/audio-benchmark.js",
    "verify": "npm run build:main && npm run build:web && node tools/check-syntax.js && npm run test:unit && npm run test:web && npm run typecheck && npm run build:renderer && node tools/check-renderer.js && node tools/check-site.js",
    "test:unit": "node tests/run.js && node --test tests/modernization.test.js tests/build.test.js tests/profiles.test.js tests/security.test.js",
    "build:app": "npm run build:main && npm run build:renderer && node tools/check-renderer.js",
    "package:all": "electron-builder -wml --publish never",
    "package:win": "electron-builder -w --publish never",
    "package:mac": "electron-builder -m --publish never",
    "package:linux": "electron-builder -l --publish never",
    "prepare:windows": "npm run build:main && node tools/prepare-windows-runtime.js",
    "release:metadata": "node tools/release-metadata.js",
    "test:web": "node --test tests/web.test.js",
    "test:site": "playwright test"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [],
  "homepage": "https://mechvibes-cbc.pages.dev/",
  "author": {
    "name": "Hai Nguyen",
    "email": "hainguyen.ts13@gmail.com"
  },
  "license": "MPL-2.0",
  "build": {
    "appId": "com.electron.mechvibes-cbc",
    "artifactName": "Mechvibes-${version}-${arch}.${ext}",
    "files": [
      "src/**/*",
      "package.json",
      "!src/**/*.map",
      "!src/**/*.ts",
      "!src/**/*.tsx",
      "!src/renderer/**/*"
    ],
    "generateUpdatesFilesForAllChannels": true,
    "publish": [
      {
        "provider": "github",
        "owner": "omnizs38",
        "repo": "mechvibes-cbc"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "./build/installer.nsh",
      "perMachine": false,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "en_US",
        "ru_RU"
      ],
      "displayLanguageSelector": false,
      "warningsAsErrors": true,
      "license": "LICENSE"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/assets/icon.png"
    },
    "mac": {
      "category": "public.app-category.entertainment",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/assets/icon.png"
    },
    "linux": {
      "category": "Utility",
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "snap",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/assets/icon.png"
    },
    "beforePack": "./tools/before-pack.js",
    "extraFiles": [
      {
        "from": "LICENSE",
        "to": "LICENSE.Mechvibes.txt"
      },
      {
        "from": "LICENSE.MIT",
        "to": "LICENSE.upstream.txt"
      },
      {
        "from": "NOTICE",
        "to": "NOTICE.Mechvibes.txt"
      }
    ]
  },
  "dependencies": {
    "@electron/remote": "^2.1.3",
    "adm-zip": "^0.6.0",
    "easy-volume": "^1.2.0",
    "electron-log": "^5.4.4",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "fs-extra": "^11.4.0",
    "mime-types": "^3.0.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/adm-zip": "^0.5.7",
    "@types/fs-extra": "^11.0.4",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^43.6.0",
    "electron-builder": "^26.16.1",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
